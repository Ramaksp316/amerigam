datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(uuid())
  amerigamId String?  @unique
  email     String    @unique
  password  String
  name             String?

  // Onboarding Fields
  masterPath    String?
  corePath      String?
  hobbies       String?  // Store as stringified JSON array
  mindset       String?
  vision        String?
  username      String?  @unique
  bio           String?
  location      String?
  portfolioUrl  String?
  avatarData    String?  // Base64 string for cropped image
  onboarded     Boolean  @default(false)

  posts            Post[]
  comments         Comment[]
  likes            Like[]
  followers        Follow[]  @relation("followers")
  following        Follow[]  @relation("following")
  sentMessages     Message[] @relation("sentMessages")
  receivedMessages Message[] @relation("receivedMessages")
  
  notifications    Notification[] @relation("userNotifications")
  actedNotifications Notification[] @relation("actorNotifications")
  pushSubscriptions  PushSubscription[]

  // Task relations
  assignedTasks    CommunityTask[] @relation("assignedTasks")
  createdTasks     CommunityTask[] @relation("createdTasks")

  createdAt        DateTime  @default(now())

  // Communities (Phase 1)
  ownedCommunities Community[]
  communityMembers CommunityMember[]
  communityPosts   CommunityPost[]

  // Competitions & Portfolios (Phase 2)
  // Competitions & Portfolios (Phase 2)
  eventRegistrations EventRegistration[]
  createdEvents      Event[]
  scannedCheckIns    EventCheckIn[]
  captainedTeams     EventTeam[]
  evaluations        EventEvaluation[]
  achievements       Achievement[]

  // Online Status fields
  status                String    @default("ONLINE") // "ONLINE", "OFFLINE", "DND"
  lastSeen              DateTime  @default(now())
  customStatus          String?   // 24-hour custom status (e.g. "Working on Amerigam")
  customStatusExpiresAt DateTime? // When this custom status expires
  updatedNotes          CommunityNote[] @relation("updatedNotes")
}

model Post {
  id        String    @id @default(uuid())
  content   String
  mediaUrl  String?
  mediaType String?
  aspectRatio String?   @default("original")
  relatedMasterPath String?
  relatedCorePath   String?
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  comments  Comment[]
  likes     Like[]
  createdAt DateTime  @default(now())
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  follower    User     @relation("following", fields: [followerId], references: [id])
  following   User     @relation("followers", fields: [followingId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model Message {
  id         String   @id @default(uuid())
  content    String
  senderId   String
  receiverId String
  sender     User     @relation("sentMessages", fields: [senderId], references: [id])
  receiver   User     @relation("receivedMessages", fields: [receiverId], references: [id])
  createdAt  DateTime @default(now())
  isEdited   Boolean  @default(false)
}

// =========================================
// Communities & Guilds (Phase 1)
// =========================================

model Community {
  id          String   @id @default(uuid())
  name        String
  description String?
  avatarData  String?  // Base64 string for group photo
  category    String?  // e.g. "Tech & AI", "Visual Arts"
  type        String   @default("PUBLIC") // "PUBLIC" or "FRIEND_GROUP"
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id])
  members     CommunityMember[]
  posts       CommunityPost[]
  tasks       CommunityTask[]
  notes       CommunityNote[]
  createdAt   DateTime @default(now())
}

model CommunityMember {
  id          String   @id @default(uuid())
  userId      String
  communityId String
  user        User      @relation(fields: [userId], references: [id])
  community   Community @relation(fields: [communityId], references: [id])
  joinedAt    DateTime  @default(now())
  
  @@unique([userId, communityId])
}

model CommunityPost {
  id          String   @id @default(uuid())
  content     String
  mediaUrl    String?
  mediaType   String?
  authorId    String
  communityId String
  author      User      @relation(fields: [authorId], references: [id])
  community   Community @relation(fields: [communityId], references: [id])
  createdAt   DateTime  @default(now())
}

model CommunityTask {
  id          String   @id @default(uuid())
  title       String
  description String?
  communityId String
  assigneeId  String?
  creatorId   String
  deadline    DateTime?
  status      String   @default("PENDING") // "PENDING", "IN_PROGRESS", "COMPLETED"
  
  community   Community @relation(fields: [communityId], references: [id])
  assignee    User?     @relation("assignedTasks", fields: [assigneeId], references: [id])
  creator     User      @relation("createdTasks", fields: [creatorId], references: [id])
  createdAt   DateTime  @default(now())
}

// =========================================
// Competitions & Portfolios (Phase 2)
// =========================================

model Event {
  id                String   @id @default(uuid())
  name              String
  description       String
  category          String   // e.g., "Tech & AI", "Hackathon", "Sports"
  locationType      String   // "ONLINE", "OFFLINE", "HYBRID"
  venue             String?
  startDate         DateTime
  endDate           DateTime
  registrationStart DateTime?
  registrationEnd   DateTime?
  
  // Toggles
  requireApproval   Boolean  @default(false)
  requireCheckIn    Boolean  @default(false)
  requireBadge      Boolean  @default(false)
  enableDigitalPass Boolean  @default(true)
  enableCertificates Boolean @default(false)
  allowTeams        Boolean  @default(false)
  requireSubmissions Boolean @default(false)
  
  // Limits & Config
  participantLimit  Int?
  evaluationMethod  String   @default("NONE") // "NONE", "JUDGE_PANEL", "OBJECTIVE"
  
  creatorId         String
  creator           User     @relation(fields: [creatorId], references: [id])
  registrations     EventRegistration[]
  createdAt         DateTime @default(now())
}

model EventRegistration {
  id              String   @id @default(uuid())
  registrationId  String   @unique // e.g., AMG-R-2026-XXXX
  userId          String
  eventId         String
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  participantType String   @default("PARTICIPANT")
  qrToken         String   @unique @default(uuid()) // Secure opaque token for QR
  teamId          String?

  user            User       @relation(fields: [userId], references: [id])
  event           Event      @relation(fields: [eventId], references: [id])
  team            EventTeam? @relation(fields: [teamId], references: [id])
  checkIns        EventCheckIn[]
  submissions     EventSubmission[]
  evaluations     EventEvaluation[]
  certificates    EventCertificate[]
  joinedAt        DateTime   @default(now())

  @@unique([userId, eventId])
}

model EventCheckIn {
  id              String   @id @default(uuid())
  registrationId  String
  scannedById     String
  gateInfo        String?
  timestamp       DateTime @default(now())

  registration    EventRegistration @relation(fields: [registrationId], references: [id])
  scannedBy       User              @relation(fields: [scannedById], references: [id])
}

model EventTeam {
  id          String   @id @default(uuid())
  name        String
  captainId   String
  eventId     String
  teamCode    String   @unique @default(uuid()) // Shareable code to join

  captain     User     @relation(fields: [captainId], references: [id])
  members     EventRegistration[]
  createdAt   DateTime @default(now())
}

model EventSubmission {
  id             String   @id @default(uuid())
  registrationId String
  projectTitle   String
  description    String?
  contentUrl     String?
  status         String   @default("SUBMITTED")

  registration   EventRegistration @relation(fields: [registrationId], references: [id])
  createdAt      DateTime @default(now())
}

model EventEvaluation {
  id             String   @id @default(uuid())
  registrationId String
  judgeId        String
  score          Float
  feedback       String?

  registration   EventRegistration @relation(fields: [registrationId], references: [id])
  judge          User              @relation(fields: [judgeId], references: [id])
  evaluatedAt    DateTime          @default(now())
}

model EventCertificate {
  id             String   @id @default(uuid())
  certificateId  String   @unique // AMG-C-2026-XXXX
  registrationId String
  type           String   @default("PARTICIPATION") // PARTICIPATION, WINNER, MERIT
  issueDate      DateTime @default(now())

  registration   EventRegistration @relation(fields: [registrationId], references: [id])
}

model Achievement {
  id          String   @id @default(uuid())
  userId      String
  title       String   // e.g., "National Champion 2026"
  description String?
  badgeIcon   String?  // Emoji or image URL
  user        User     @relation(fields: [userId], references: [id])
  earnedAt    DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   // User receiving the notification
  user      User     @relation("userNotifications", fields: [userId], references: [id])
  actorId   String?  // User who triggered the notification (optional)
  actor     User?    @relation("actorNotifications", fields: [actorId], references: [id])
  type      String   // 'message', 'like', 'comment', 'follow'
  content   String   // Text description
  isRead    Boolean  @default(false)
  link      String?  // Destination URL
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model CommunityNote {
  id          String   @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  title       String   @default("Untitled Page")
  content     String   @default("")
  penColor    String   @default("#0000ff") // Default blue ink
  updatedById String?
  updatedBy   User?     @relation("updatedNotes", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}
